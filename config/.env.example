# C.O.R.E. AI :: Sovereign Life OS - Environment Configuration Template
# Copy this file to config/.env and configure your sovereign settings.

# 1. Sovereign Node & Universal Gateway Binding
CORE_HOST=0.0.0.0
CORE_PORT=8000
CORE_NODE_ROLE=main_server
CORE_FORCE_HEURISTIC=0

# 2. Master Security Secret (Required for OWNER tier enrollment across LAN/Mesh)
# Generate a secure 32+ character random hex token or let setup wizard generate it.
CORE_AUTH_SECRET=generate_your_own_sovereign_secret_key_here

# 3. AI Intelligence Provider API Keys (Configure your preferred providers)
# Google Gemini (High-Speed Cloud Reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. Local Offline Ollama (Zero Cloud Silicon)
# Default is http://localhost:11434. Uncomment if hosted remotely on your LAN.
# OLLAMA_API_BASE=http://localhost:11434

# 5. Smart Home Integration (Home Assistant bridge)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_ha_long_lived_token
